# Required: Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Admin panel password (required to enable /admin)
ADMIN_PASSWORD=change-me

# Optional: Supabase storage (run supabase/schema.sql first). Without these, incidents use data/incidents.json
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
